            <ns3:atemp>29.0</ns3:atemp>
            <ns3:hr>160</ns3:hr>
            <ns3:cad>95</ns3:cad>
          </ns3:TrackPointExtension>
        </extensions>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
